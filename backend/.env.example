# IRIS AI Hub Studio Backend - Environment Variables
# Copy this file to .env and fill in the values

# =============================================================================
# Server Configuration
# =============================================================================

# Server port
PORT=3000

# CORS settings
CORS_ORIGIN=*

# =============================================================================
# IRIS Connection Configuration
# =============================================================================

# IRIS server connection
IRIS_HOST=localhost
IRIS_PORT=1972
IRIS_WEB_PORT=52773

# IRIS authentication
IRIS_NAMESPACE=USER
IRIS_USERNAME=_SYSTEM
IRIS_PASSWORD=SYS

# AI Hub settings
AI_HUB_ENABLED=true
AI_HUB_PORT=53773
AI_HUB_WS_PORT=53773

# Connection timeouts (in milliseconds)
IRIS_CONNECTION_TIMEOUT=5000
IRIS_REQUEST_TIMEOUT=30000

# SSL/TLS settings
IRIS_USE_SSL=false
NODE_TLS_REJECT_UNAUTHORIZED=1

# =============================================================================
# Development Settings
# =============================================================================

# Node environment
NODE_ENV=development

# Debug mode
DEBUG=false

# =============================================================================
# Security Settings
# =============================================================================

# Session secret (generate a new one for production)
SESSION_SECRET=your-session-secret-here

# JWT secret (generate a new one for production)
JWT_SECRET=your-jwt-secret-here

# =============================================================================
# Logging Settings
# =============================================================================

# Log level (debug, info, warn, error)
LOG_LEVEL=info

# Log directory
LOG_DIR=./logs
